---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = "/,/about.html,/services.html,/team.html,/insights.html" | split: "," %}
{%- for path in pages %}
  <url><loc>{{ site.url }}{{ path }}</loc><lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.last_modified_at | default: post.date | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
